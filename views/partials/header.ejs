<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' && title ? title + ' | ' : '' %><%= c.site.name %> | St. Gallenkirch | Montafon</title>
  <meta name="description" content="Gönn' dir eine Auszeit auf 1.500 Höhenmeter! Ferienwohnung in Garfrescha, mitten im Skigebiet Silvretta Montafon – Urlaub in der charakteristisch schönen Maisäß-Landschaft.">
  <link rel="stylesheet" href="/fonts/fonts.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/fs-consent.css">
  <script type="application/json" id="fs-consent-config">
  {
    "privacyUrl": "/datenschutz",
    "imprintUrl": "/impressum",
    "position": "bottom-left",
    "tone": "du",
    "categories": {}
  }
  </script>
  <link rel="icon" href="/images/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/images/favicon.png">
  <style>
    .brand-logo { height: 54px; width: auto; display: block; }
    .footer-logo { width: 150px; height: auto; margin-bottom: .8rem; }
    .hero-logo { width: min(400px, 68vw); height: auto; margin: 0 auto .5rem; filter: drop-shadow(0 8px 32px rgba(0,0,0,.5)); }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }
    .floorplan { margin-top: 1.5rem; }
    .floorplan img { border-radius: 14px; box-shadow: 0 10px 30px rgba(53,46,40,.12); background: #fff; padding: 1rem; cursor: zoom-in; margin: 0 auto; }
    @media (max-width: 860px) { .brand-logo { height: 44px; } }
  </style>
</head>
<body>
<header class="site-header" id="siteHeader">
  <div class="header-inner">
    <a href="/" class="brand">
      <img src="/images/logo-white.png" alt="<%= c.site.name %>" class="brand-logo">
    </a>
    <nav class="main-nav" id="mainNav">
      <a href="/" class="<%= page === '/' ? 'active' : '' %>">Home</a>
      <a href="/wohnung" class="<%= page === '/wohnung' ? 'active' : '' %>">Wohnung</a>
      <a href="/anreise" class="<%= page === '/anreise' ? 'active' : '' %>">Anreise</a>
      <a href="/sommer" class="<%= page === '/sommer' ? 'active' : '' %>">Sommer</a>
      <a href="/winter" class="<%= page === '/winter' ? 'active' : '' %>">Winter</a>
      <a href="/kontakt" class="<%= page === '/kontakt' ? 'active' : '' %>">Kontakt</a>
      <a href="/anfrage" class="btn btn-accent nav-cta">Anfrage</a>
    </nav>
    <button class="nav-toggle" id="navToggle" aria-label="Menü öffnen" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
