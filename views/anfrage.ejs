<%- include('partials/header', { title: 'Anfrage' }) %>

<section class="page-hero" style="background-image:url('/images/sommer-04.jpg')">
  <div class="hero-overlay"></div>
  <div class="page-hero-content">
    <h1>Unverbindliche Anfrage</h1>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <div class="success-box reveal" id="mailHint" hidden>
      <h2>Fast geschafft! ✉</h2>
      <p>Dein E-Mail-Programm hat sich mit der fertigen Anfrage geöffnet – bitte dort noch auf <strong>Senden</strong> klicken.</p>
      <p class="form-note">Kein Fenster aufgegangen? Dann schreib uns direkt an <a href="mailto:<%= c.site.email %>"><%= c.site.email %></a></p>
      <a href="/" class="btn btn-outline">Zurück zur Startseite</a>
    </div>

    <form id="inquiryForm" class="inquiry-form reveal">
      <div class="form-row">
        <label>Name *<input type="text" name="name" required></label>
        <label>E-Mail *<input type="email" name="email" required></label>
      </div>
      <div class="form-row">
        <label>Telefon<input type="tel" name="telefon"></label>
        <label>Personen *
          <select name="personen" required>
            <% [1,2,3,4,5].forEach(n => { %>
              <option value="<%= n %>"><%= n %> <%= n === 1 ? 'Person' : 'Personen' %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <div class="form-row">
        <label>Anreise *<input type="date" name="anreise" required></label>
        <label>Abreise *<input type="date" name="abreise" required></label>
      </div>
      <label>Nachricht<textarea name="nachricht" rows="5" placeholder="Deine Nachricht an uns…"></textarea></label>
      <button type="submit" class="btn btn-accent btn-lg">Anfrage senden</button>
      <p class="form-note">* Pflichtfelder. Die Anfrage ist unverbindlich. Beim Absenden öffnet sich dein E-Mail-Programm mit der fertigen Anfrage – es werden keine Daten auf unserem Server gespeichert. Details in der <a href="/datenschutz">Datenschutzerklärung</a>.</p>
    </form>
  </div>
</section>

<script>
  document.getElementById('inquiryForm').addEventListener('submit', function (e) {
    e.preventDefault();
    const f = this;
    const fmt = d => { if (!d) return '-'; const [y, m, t] = d.split('-'); return `${t}.${m}.${y}`; };
    const subject = `Anfrage ${fmt(f.anreise.value)} – ${fmt(f.abreise.value)} (${f.personen.value} Pers.) von ${f.name.value}`;
    const body =
`Liebe Familie Felder,

ich interessiere mich für einen Aufenthalt im Haus Felder Garfrescha:

Name:     ${f.name.value}
E-Mail:   ${f.email.value}
Telefon:  ${f.telefon.value || '-'}
Anreise:  ${fmt(f.anreise.value)}
Abreise:  ${fmt(f.abreise.value)}
Personen: ${f.personen.value}

Nachricht:
${f.nachricht.value || '-'}

Liebe Grüße
${f.name.value}`;
    window.location.href = 'mailto:<%= c.site.email %>?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    document.getElementById('mailHint').hidden = false;
    document.getElementById('mailHint').classList.add('visible');
    f.scrollIntoView === undefined || document.getElementById('mailHint').scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>

<%- include('partials/footer') %>
