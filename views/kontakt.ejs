<%- include('partials/header', { title: 'Kontakt' }) %>

<section class="page-hero" data-ez-bg="bild.kontakt.hero" style="background-image:url('<%= ez.bild('bild.kontakt.hero', '/images/winter-04.jpg') %>')">
  <div class="hero-overlay"></div>
  <div class="page-hero-content">
    <h1 data-ez="kontakt.title"><%- ez.t('kontakt.title') %></h1>
  </div>
</section>

<section class="section" id="kontakt">
  <div class="container cols-2">
    <div class="panel contact-panel reveal">
      <img src="/images/logo.png" alt="Haus Felder Garfrescha Logo" class="contact-logo">
      <h3 data-ez="global.site.name"><%- ez.t('global.site.name') %></h3>
      <p class="contact-name" data-ez="global.kontakt.name"><%- ez.t('global.kontakt.name') %></p>
      <p>
        📞 <a href="tel:<%= ez.text('global.site.phone').replace(/\s+/g, '') %>"><span data-ez="global.site.phone"><%- ez.t('global.site.phone') %></span></a><br>
        ✉ <a href="mailto:<%= ez.text('global.site.email') %>"><span data-ez="global.site.email"><%- ez.t('global.site.email') %></span></a>
      </p>
      <p data-ez="kontakt.folgeText"><%- ez.t('kontakt.folgeText', 'Folge uns auch auf:') %></p>
      <div class="social social-dark">
        <a href="<%= ez.text('global.site.facebook') %>" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5H16.7V3.6c-.3-.04-1.3-.13-2.5-.13-2.5 0-4.2 1.5-4.2 4.3v2.1H7.3V13H10v8z"/></svg>
        </a>
        <a href="<%= ez.text('global.site.instagram') %>" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
        </a>
      </div>
      <p><a href="/files/agb.pdf" target="_blank">Es gelten die AGB für Ferienwohnungen (PDF)</a></p>
      <a href="<%= ez.link('kontakt.knopfAnfrage', '/anfrage') %>" class="btn btn-accent" data-ez="kontakt.knopfAnfrage"><%- ez.t('kontakt.knopfAnfrage', 'Unverbindliche Anfrage') %></a>
    </div>

    <div class="reveal">
      <div class="panel panel-muted">
        <h3 data-ez="kontakt.buchbarText"><%- ez.t('kontakt.buchbarText') %></h3>
        <div class="booking-logos">
          <a href="https://www.montafon.at/de/haus-felder-garfrescha_vc17881" target="_blank" rel="noopener"><img src="/images/logo-montafon.jpg" alt="Montafon"></a>
          <a href="https://www.booking.com/hotel/at/haus-felder-garfrescha.de.html" target="_blank" rel="noopener"><img src="/images/logo-booking.jpg" alt="Booking.com"></a>
        </div>
      </div>
      <div class="panel" style="margin-top:1.5rem">
        <h3 data-ez="kontakt.ausgebuchtText"><%- ez.t('kontakt.ausgebuchtText') %></h3>
        <ul class="list-dash">
          <li><a href="http://www.hausaelpele-garfrescha.at" target="_blank" rel="noopener"><span data-ez="kontakt.empfehlung1"><%- ez.t('kontakt.empfehlung1') %></span></a></li>
          <li><a href="http://www.alphuette.at" target="_blank" rel="noopener"><span data-ez="kontakt.empfehlung2"><%- ez.t('kontakt.empfehlung2') %></span></a></li>
        </ul>
        <h3 style="margin-top:1.5rem" data-ez="kontakt.talText"><%- ez.t('kontakt.talText') %></h3>
        <ul class="list-dash">
          <li><a href="http://www.haus-lifinar.at" target="_blank" rel="noopener"><span data-ez="kontakt.tal1"><%- ez.t('kontakt.tal1') %></span></a></li>
          <li><a href="http://www.info-felder.at" target="_blank" rel="noopener"><span data-ez="kontakt.tal2"><%- ez.t('kontakt.tal2') %></span></a></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
